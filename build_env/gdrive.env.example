# Публичные ссылки на файлы Google Диска.
# Нужна ссылка вида https://drive.google.com/file/d/FILE_ID/view
# Ссылка на Google Документ (docs.google.com/document) не скачивается.
# Локальные замены кладите в build_env/gdrive.env — этот файл образец.

# На Диске файл называется wine-recognizer-v5-muscat.tar (~7.5 ГБ).
GDRIVE_RECOGNIZER_URL=https://drive.google.com/file/d/1UxZS4mxsFoLbzn0kYlqVCFYVDylGH6eu/view?usp=drive_link
# На Диске файл называется catalog-images-v1.tar (~145 МБ).
GDRIVE_CATALOG_IMAGES_URL=https://drive.google.com/file/d/1ej6_bL3JO4mYKs7Izjel6E5IMm6f1goS/view?usp=drive_link
# На Диске файл называется recommendations-v2.tar.gz.
GDRIVE_RECOMMENDATIONS_URL=https://drive.google.com/file/d/1IOhFNwSN3DrTZGStjkQt8yM3HswRywyJ/view?usp=drive_link
