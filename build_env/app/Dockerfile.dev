FROM node:22-alpine

WORKDIR /app

COPY package.json nuxt.config.ts tsconfig.json eslint.config.mjs vitest.config.ts ./
COPY app ./app
COPY public ./public
COPY server ./server
COPY tests ./tests
COPY build_env/app/entrypoint.dev.sh /entrypoint.dev.sh
RUN chmod +x /entrypoint.dev.sh

EXPOSE 3000

ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000
ENV HOST=0.0.0.0
ENV PORT=3000

ENTRYPOINT ["/entrypoint.dev.sh"]
