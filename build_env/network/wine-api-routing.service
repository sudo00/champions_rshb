[Unit]
Description=Route wine API replies through the LAN gateway instead of the VPN
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/wine-api-network.env
# Lower priorities run first: the VPN currently installs its catch-all at 9999.
# Remove the legacy exception as well when upgrading an existing installation.
ExecStartPre=-/usr/sbin/ip -4 rule del priority 10000 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
ExecStartPre=-/usr/sbin/ip -4 rule del priority 9000 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
ExecStart=/usr/sbin/ip -4 rule add priority 9000 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
RemainAfterExit=yes
ExecStop=-/usr/sbin/ip -4 rule del priority 9000 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main

[Install]
WantedBy=multi-user.target
