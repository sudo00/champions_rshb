[Unit]
Description=Route wine API replies through the LAN gateway instead of the VPN
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/wine-api-network.env
# Run this narrow exception before VPN catch-all rules (observed at 99/8999/9999).
# Priority 0 remains reserved for the local table. Remove legacy exceptions.
ExecStartPre=-/usr/sbin/ip -4 rule del priority 10000 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
ExecStartPre=-/usr/sbin/ip -4 rule del priority 9000 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
ExecStartPre=-/usr/sbin/ip -4 rule del priority 100 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
ExecStartPre=-/usr/sbin/ip -4 rule del priority 1 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
ExecStart=/usr/sbin/ip -4 rule add priority 1 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main
RemainAfterExit=yes
ExecStop=-/usr/sbin/ip -4 rule del priority 1 from ${WINE_API_SOURCE_IP}/32 ipproto tcp sport 8000 lookup main

[Install]
WantedBy=multi-user.target
